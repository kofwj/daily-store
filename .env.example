# 复制为 .env 后改。不要提交 .env。

# 必填。生成：python3 -c 'import secrets; print(secrets.token_hex(32))'
STORE_DAILY_SECRET=replace-with-random-secret

# 安全默认：使用受控 TLS / Cloudflare Tunnel 时设为 1。
# 只有明确接受 LAN 明文风险时才设为 0，并限制 CADDY_BIND 为内网网卡。
STORE_DAILY_SECURE=1
STORE_DAILY_TRUST_PROXY=1

# 默认：本机回环 + Cloudflare Tunnel。局域网明文 HTTP 见 docs/deploy-vps.md 的 opt-in。
APP_DOMAIN=your-lan-host
CADDY_BIND=127.0.0.1
CADDY_PORT=8099
CADDYFILE=./caddy/Caddyfile.tunnel

# 本机同步到生产机用（scripts/sync_to_vps.sh）
VPS_HOST=your-primary-host
VPS_USER=root
VPS_DIR=/opt/store-daily
