# 复制为 .env 后改。不要提交 .env。

# 必填。生成：python3 -c 'import secrets; print(secrets.token_hex(32))'
STORE_DAILY_SECRET=replace-with-random-secret

# 局域网 HTTP 必须为 0，否则登录 Cookie 带不回去。
# 以后上了 HTTPS / Cloudflare 再改成 1。
STORE_DAILY_SECURE=0

# 局域网直连
APP_DOMAIN=192.168.100.5
CADDY_BIND=0.0.0.0
CADDY_PORT=8099
CADDYFILE=./caddy/Caddyfile.lan

# 本机同步到 VPS 用（scripts/sync_to_vps.sh）
VPS_HOST=192.168.100.5
VPS_USER=root
VPS_DIR=/opt/store-daily
