# 复制为 scripts/backup.env 后按需改（backup.env 已在 .gitignore）
# 用法：set -a; . scripts/backup.env; set +a; ./scripts/backup_offsite.sh

PRIMARY_HOST=your-primary-host
PRIMARY_USER=root
PRIMARY_SSH_PORT=22

# 局域网备份机（NAS / 安卓 Termux 等）
LAN_BACKUP_HOST=your-lan-backup-host
LAN_BACKUP_USER=backup
LAN_BACKUP_DIR=store-daily-backups
LAN_BACKUP_SSH_PORT=22

# 异地备份机（备份仓库；≠ 灾备热备机）
REMOTE_BACKUP=your-standby-host
REMOTE_BACKUP_USER=root
REMOTE_BACKUP_DIR=store-daily-backups
REMOTE_BACKUP_SSH_PORT=22

# 灾备热备机（deploy_pve_standby.sh 用）：与备份仓库是两个角色，别混填
#DR_STANDBY_HOST=your-dr-standby-host
#DR_STANDBY_USER=root
#DR_STANDBY_SSH_PORT=22

# 备份失败告警 webhook（留空则自动读生产库 app_meta.wecom_global）
#ALERT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
#
# 库未变化的小时也探活落点（=0 关掉；全挂 → exit 1 并告警）
#SKIP_PROBE=1

KEEP_DAYS=30

# 代码 bundle 在备份机上保留的份数（backup_code.sh 推送后自动清理旧的；0 = 不清理）
CODE_BUNDLE_KEEP=10
